# ─── BDVault environment variables ──────────────────────────────────────────
# Copy this file to `.env` on your production server (or set these in Apache
# with `SetEnv`, in Docker with `-e`, or whatever your host supports) and fill
# in the real values.
#
# `.env` is in .gitignore and must NEVER be committed.
#
# Local XAMPP dev does NOT need any of these — config/database.php uses
# root/empty-password defaults when running against localhost / 127.0.0.1.

# ─── Database ────────────────────────────────────────────────────────────────
BDVAULT_DB_HOST=localhost
BDVAULT_DB_USER=your_db_user
BDVAULT_DB_PASS=change_me_to_a_rotated_strong_password
BDVAULT_DB_NAME=your_db_name

# ─── AI (Gemini) ─────────────────────────────────────────────────────────────
# Required for the AI assistants (AreaStatementAIAssistant, DAExplainerAssistant,
# PlanAIAssistant). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─── AI (OpenAI) ─────────────────────────────────────────────────────────────
# Optional — only needed if an OpenAI code path is enabled in your deployment.
OPENAI_API_KEY=
