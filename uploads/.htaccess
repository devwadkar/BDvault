# Deny direct web access to uploaded files.
# PHP execution is also disabled so uploaded .php payloads can't be run.
<FilesMatch "\.(php|phtml|phar|pl|py|cgi|sh)$">
    Require all denied
</FilesMatch>

# Serve all other files as plain downloads.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
